# Copy to .env (gitignored) and fill in. ./run.sh loads it. Never commit real keys.

# Required. Gemini 4 sees every frame.
GEMINI_API_KEY=
# Fast Gemini 4 for frames. `./run.sh` prints the gemini-4 models your key can call.
GEMINI_MODEL=gemini-4-hydrogen
# Used for speech/tasks/answers only when OPENAI_API_KEY is empty.
GEMINI_TEXT_MODEL=gemini-4-hydrogen
GEMINI_EMBED_MODEL=gemini-embedding-001

# Optional. When set, OpenAI does hearing (Whisper), thinking, and embeddings.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini

# Optional. Test-mode key only (sk_test_...); live keys are refused.
STRIPE_SECRET_KEY=
PAY_MAX_CENTS=5000
PAY_DAILY_CENTS=10000

# Optional. Spoken answers; macOS `say` without it.
ELEVENLABS_API_KEY=

# HTTPS tunnel URL so the glasses display can load thumbnails (cloudflared).
PUBLIC_BASE_URL=
