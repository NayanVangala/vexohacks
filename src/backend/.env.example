# Copy to .env (gitignored) and fill in. ./run.sh loads it. Never commit real keys.

# Required. Gemini 4 sees every frame.
GEMINI_API_KEY=
# Fast Gemini 4 for frames. `./run.sh` prints the gemini-4 models your key can call.
GEMINI_MODEL=gemini-4-hydrogen
# Used for speech/tasks/answers only when OPENAI_API_KEY is empty.
GEMINI_TEXT_MODEL=gemini-4-hydrogen
GEMINI_EMBED_MODEL=gemini-embedding-001

# Optional. When set, OpenAI does hearing (Whisper), thinking, and embeddings.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini

# Optional. Test-mode key only (sk_test_...); live keys are refused. Used for owed-money requests AND food orders.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
PAY_MAX_CENTS=5000
PAY_DAILY_CENTS=10000

# Optional. Spoken answers; macOS `say` without it.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=T2sZgOl8ol4kf4u6yM2z
# Where Scene's voice plays: glasses (via the phone, default), laptop, or both. Use `both` while testing.
SCENE_SPEAK_ON=glasses

# HTTPS tunnel URL so the glasses display can load thumbnails (cloudflared).
PUBLIC_BASE_URL=

# Follow-Through (src/followthrough, runs on :8002). The glasses app reaches it through /ft/*.
FOLLOWTHROUGH_URL=http://localhost:8002
# Set to also send what the glasses hear into Follow-Through every ~30 s (it then finds commitments).
FOLLOWTHROUGH_FORWARD_URL=http://localhost:8002

# --- Scene awareness, email/calendar, ordering (see README: Scene awareness, Agentic ordering) ---
WEARER_NAME=Srijan
TIMEZONE=America/Los_Angeles
# The Apps Script that really sends email and creates calendar events (src/followthrough/apps_script/Code.gs).
# Email always goes to DEMO_EMAIL_TO, never the person named in the notes.
EXECUTOR_URL=
EXECUTOR_TOKEN=
DEMO_EMAIL_TO=
CALENDAR_ACCOUNT=
# "Nearest McDonald's": the phone/glasses post their GPS to /location; this is the fallback (lat,lng).
SCENE_LOCATION=
# Place and menu lookups: fast (~2 s) by default; gemini-4-hydrogen is more accurate but ~40 s.
GEMINI_GROUNDED_MODEL=gemini-3.1-flash-lite
# Scene awareness tuning. The phone uploads a frame every 0.5 s, so 3 frames is only ~1.5 s: raise it if offers misfire.
SCENE_NEED_FRAMES=3
SCENE_MIN_CONF=0.6
# Demo kitchen timers (seconds after payment).
KITCHEN_PREP_S=10
KITCHEN_READY_S=40
# 1 = enable /dev/* routes (inject a scene or a spoken line without glasses). Leave unset for the real demo.
SCENE_DEV=
